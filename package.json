{
  "name": "community-support-foundation",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "build:verify": "node scripts/verify-production-build.mjs",
    "deploy:check": "tsx scripts/check-deployment.ts",
    "demo:check": "node scripts/check-demo-routes.mjs",
    "demo:export": "node scripts/build-shareable-demo.mjs",
    "start": "next start",
    "lint": "eslint . --max-warnings=0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:database": "node scripts/verify-isolated-database.mjs",
    "test:watch": "vitest",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "node scripts/deploy-migrations.mjs",
    "db:seed": "tsx prisma/seed.ts",
    "admin:bootstrap": "tsx scripts/bootstrap-admin.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1155.0",
    "@prisma/adapter-pg": "^6.15.0",
    "@prisma/client": "^6.15.0",
    "@vercel/oidc-aws-credentials-provider": "^3.3.15",
    "argon2": "^0.41.1",
    "jose": "^6.1.0",
    "next": "^15.5.28",
    "pg": "^8.16.3",
    "pino": "^9.9.0",
    "pino-http": "^10.5.0",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@eslint/js": "^9.33.0",
    "@next/eslint-plugin-next": "^15.5.28",
    "@types/node": "^24.3.0",
    "@types/pg": "^8.15.5",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.3",
    "@vitest/coverage-v8": "4.1.12",
    "eslint": "^9.33.0",
    "eslint-config-next": "^15.5.28",
    "prettier": "^3.6.2",
    "prisma": "^6.15.0",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.39.0",
    "vite": "7.3.7",
    "vitest": "4.1.12"
  },
  "overrides": {
    "next": {
      "postcss": "8.5.31"
    }
  }
}
