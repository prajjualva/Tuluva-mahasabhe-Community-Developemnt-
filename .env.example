DATABASE_URL="postgresql://foundation_app:change-me@localhost:5432/community_support?schema=public"
# Optional direct / non-pooled migration connection. Never expose it to the client.
MIGRATION_DATABASE_URL=""
APP_URL="http://localhost:3000"
# Required in production: a random value of 32+ characters. Do not reuse this placeholder.
AUTH_SECRET="replace-with-a-32-byte-minimum-random-secret"
# Required in production: a distinct base64-encoded 32-byte AES key. Keep stable and back it up securely.
BANK_ENCRYPTION_KEY=""
# Optional trusted HTTPS delivery bridges. POST JSON includes channel, destination,
# code, purpose and expiresInSeconds; success requires HTTP 2xx. Never log codes.
EMAIL_TRANSPORT_URL=""
EMAIL_TRANSPORT_TOKEN=""
# Optional direct email provider: bridge (default) or resend. Never use NEXT_PUBLIC keys.
EMAIL_PROVIDER="bridge"
RESEND_API_KEY=""
# A plain address on a domain verified in your Resend account, e.g. no-reply@notify.example.org.
# resend.dev is allowed only for local provider testing, never production.
RESEND_FROM_EMAIL=""
SMS_TRANSPORT_URL=""
SMS_TRANSPORT_TOKEN=""
LOG_LEVEL="info"
UPLOAD_STORAGE="local"
UPLOAD_LOCAL_PATH="./uploads"
# Production serverless documents: use a private AWS S3 bucket with Block Public
# Access, bucket-owner-enforced ownership, encryption, versioning and retention.
# Prefer workload-role credentials. Never expose these values to the browser.
S3_PRIVATE_BUCKET=""
AWS_REGION=""
# Vercel: production-scoped IAM role via OIDC; do not create permanent AWS keys.
AWS_ROLE_ARN=""
# Optional for a separate non-Vercel local workload only. Never use root keys.
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""
# Online payment stays unavailable until all Razorpay values below are set. Never
# expose RAZORPAY_KEY_SECRET or RAZORPAY_WEBHOOK_SECRET to the browser.
PAYMENT_PROVIDER=""
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
RAZORPAY_WEBHOOK_SECRET=""
INTERNAL_JOB_SECRET="set-a-strong-random-secret-for-scheduled-jobs"
# Vercel sends this as Authorization: Bearer for the daily GET jobs in vercel.json.
# Use a distinct random value of at least 32 characters.
CRON_SECRET=""
