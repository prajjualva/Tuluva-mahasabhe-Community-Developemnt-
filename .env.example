DATABASE_URL="postgresql://foundation_app:change-me@localhost:5432/community_support?schema=public"
APP_URL="http://localhost:3000"
# Required in production: a random value of 32+ characters. Do not reuse this placeholder.
AUTH_SECRET="replace-with-a-32-byte-minimum-random-secret"
LOG_LEVEL="info"
UPLOAD_STORAGE="local"
UPLOAD_LOCAL_PATH="./uploads"
# Online payment stays unavailable until all Razorpay values below are set. Never
# expose RAZORPAY_KEY_SECRET or RAZORPAY_WEBHOOK_SECRET to the browser.
PAYMENT_PROVIDER=""
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
RAZORPAY_WEBHOOK_SECRET=""
INTERNAL_JOB_SECRET="set-a-strong-random-secret-for-scheduled-jobs"
